@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.12 COMPONENTS Core)
include("${CMAKE_CURRENT_LIST_DIR}/configqmlCoreTargets.cmake")
set(configqml_Core_FOUND TRUE)
if(NOT configqml_FIND_COMPONENTS)
    if(@CONFIGQML_BUILD_QML@)
        set(configqml_FIND_COMPONENTS Qml)
        set(configqml_FIND_REQUIRED_Qml TRUE)
    endif()
endif()
set(configqml_Qml_FOUND FALSE)
foreach(component IN LISTS configqml_FIND_COMPONENTS)
    if(component STREQUAL "Qml" AND @CONFIGQML_BUILD_QML@)
        # The constructed metadata adapter is coupled to this exact private ABI.
        if(configqml_FIND_REQUIRED_Qml)
            find_dependency(Qt6 @CONFIGQML_PRIVATE_QT_VERSION@ EXACT COMPONENTS Core Qml)
        else()
            find_package(Qt6 @CONFIGQML_PRIVATE_QT_VERSION@ EXACT QUIET COMPONENTS Core Qml)
        endif()
        if(Qt6_FOUND)
            include("${CMAKE_CURRENT_LIST_DIR}/configqmlQmlTargets.cmake")
            set(configqml_Qml_FOUND TRUE)
        endif()
    endif()
endforeach()
check_required_components(configqml)
