# One owner for timing policy across native and QML test targets. Call after
# target options have been authored (the main project defers this to generation).
function(configqml_collect_timing_targets directory output)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(imported DIRECTORY "${directory}" PROPERTY IMPORTED_TARGETS)
    list(APPEND targets ${imported})
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        configqml_collect_timing_targets("${child}" nested)
        list(APPEND targets ${nested})
    endforeach()
    set("${output}" "${targets}" PARENT_SCOPE)
endfunction()

function(configqml_configure_timing_gates directory)
    get_directory_property(configs DIRECTORY "${directory}" DEFINITION CMAKE_CONFIGURATION_TYPES)
    if(NOT configs)
        get_directory_property(configs DIRECTORY "${directory}" DEFINITION CMAKE_BUILD_TYPE)
    endif()
    get_directory_property(flags DIRECTORY "${directory}" DEFINITION CMAKE_CXX_FLAGS)
    set(optimized OFF)
    foreach(config IN LISTS configs)
        string(TOUPPER "${config}" upper)
        if(upper MATCHES "^(RELEASE|RELWITHDEBINFO)$")
            set(optimized ON)
        endif()
        get_directory_property(config_flags DIRECTORY "${directory}"
            DEFINITION "CMAKE_CXX_FLAGS_${upper}")
        string(APPEND flags " ${config_flags}")
    endforeach()
    configqml_collect_timing_targets("${directory}" targets)
    foreach(target IN LISTS targets)
        foreach(property COMPILE_OPTIONS INTERFACE_COMPILE_OPTIONS)
            get_target_property(options "${target}" "${property}")
            string(APPEND flags " ${options}")
        endforeach()
    endforeach()
    # Inspect generator-expression option text conservatively: an inactive or
    # opaque sanitizer expression must not accidentally enable a timing budget.
    set(instrumented OFF)
    if(flags MATCHES "-fsanitize")
        set(instrumented ON)
    endif()
    set(CONFIGQML_TIMING_GATES AUTO CACHE STRING "Test timing gates: AUTO, ON or OFF")
    set_property(CACHE CONFIGQML_TIMING_GATES PROPERTY TYPE STRING)
    set_property(CACHE CONFIGQML_TIMING_GATES PROPERTY STRINGS AUTO ON OFF)
    string(TOUPPER "${CONFIGQML_TIMING_GATES}" mode)
    if(mode STREQUAL "AUTO")
        set(enabled OFF)
        if(optimized AND NOT instrumented)
            set(enabled ON)
        endif()
        set(gate "$<AND:$<BOOL:${enabled}>,$<CONFIG:Release,RelWithDebInfo>>")
    elseif(mode STREQUAL "ON")
        set(gate 1)
    elseif(mode STREQUAL "OFF")
        set(gate 0)
    else()
        message(FATAL_ERROR "CONFIGQML_TIMING_GATES must be AUTO, ON or OFF (got '${CONFIGQML_TIMING_GATES}')")
    endif()
    foreach(target IN LISTS ARGN)
        target_compile_definitions("${target}" PRIVATE "CONFIGQML_TIMING_GATES=${gate}")
    endforeach()
    message(STATUS "configqml timing gates: mode=${mode}, optimized=${optimized}, sanitized=${instrumented}, effective=${gate}")
endfunction()
