set(_configqml_test_generator -G "@CMAKE_GENERATOR@")
if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
    list(APPEND _configqml_test_generator -A "@CMAKE_GENERATOR_PLATFORM@")
endif()
if(NOT "@CMAKE_GENERATOR_TOOLSET@" STREQUAL "")
    list(APPEND _configqml_test_generator -T "@CMAKE_GENERATOR_TOOLSET@")
endif()
if(NOT "@CMAKE_MAKE_PROGRAM@" STREQUAL "")
    list(APPEND _configqml_test_generator "-DCMAKE_MAKE_PROGRAM=@CMAKE_MAKE_PROGRAM@")
endif()
set(_configqml_test_config)
set(_configqml_test_ctest_config)
set(_configqml_test_runtime_suffix)
if(DEFINED TEST_CONFIG AND NOT TEST_CONFIG STREQUAL "")
    list(APPEND _configqml_test_config --config "${TEST_CONFIG}")
    list(APPEND _configqml_test_ctest_config -C "${TEST_CONFIG}")
    if(NOT "@CMAKE_CONFIGURATION_TYPES@" STREQUAL "")
        list(APPEND _configqml_test_generator "-DCMAKE_CONFIGURATION_TYPES=${TEST_CONFIG}")
        set(_configqml_test_runtime_suffix "/${TEST_CONFIG}")
    else()
        list(APPEND _configqml_test_generator "-DCMAKE_BUILD_TYPE=${TEST_CONFIG}")
    endif()
endif()
