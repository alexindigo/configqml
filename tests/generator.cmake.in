set(_configqml_test_generator -G "@CMAKE_GENERATOR@")
if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
    list(APPEND _configqml_test_generator -A "@CMAKE_GENERATOR_PLATFORM@")
endif()
if(NOT "@CMAKE_GENERATOR_TOOLSET@" STREQUAL "")
    list(APPEND _configqml_test_generator -T "@CMAKE_GENERATOR_TOOLSET@")
endif()
if(NOT "@CMAKE_MAKE_PROGRAM@" STREQUAL "")
    list(APPEND _configqml_test_generator "-DCMAKE_MAKE_PROGRAM=@CMAKE_MAKE_PROGRAM@")
endif()
