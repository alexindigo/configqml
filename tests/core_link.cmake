execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Core-only consumer failed: ${result}")
endif()
foreach(binary IN ITEMS "${PROGRAM}" "${LIBRARY}")
    execute_process(COMMAND ldd "${binary}" OUTPUT_VARIABLE deps RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR NOT deps MATCHES "libQt6Core")
        message(FATAL_ERROR "Could not inspect QtCore dependency: ${deps}")
    endif()
    if(deps MATCHES "libQt6(Qml|Quick|Gui|Widgets|DBus|Concurrent|Network)")
        message(FATAL_ERROR "Unexpected Qt runtime dependency: ${deps}")
    endif()
endforeach()
