file(GLOB sources "${SOURCE_DIR}/*.cpp" "${SOURCE_DIR}/*.h")
set(count 0)
foreach(source IN LISTS sources)
    file(READ "${source}" text)
    if(text MATCHES "#[ \t]*include[ \t]*[<\"][^>\"]*private/")
        math(EXPR count "${count}+1")
        if(NOT source STREQUAL "${SOURCE_DIR}/confignamespace.cpp")
            message(FATAL_ERROR "Private API escaped its single translation unit: ${source}")
        endif()
    endif()
endforeach()
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one private Qt translation unit; found ${count}")
endif()
file(READ "${BUILD_DIR}/configqml-qt-build.txt" identity)
if(NOT identity STREQUAL "Core=6.12.0\nCorePrivate=6.12.0\nQml=6.12.0\n")
    message(FATAL_ERROR "Unexpected exact Qt adapter identity: ${identity}")
endif()
message(STATUS "Private API isolated; exact Core/CorePrivate/Qml 6.12.0 recorded")
